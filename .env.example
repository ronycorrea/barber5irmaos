# Copie para .env.local (no computador) e cadastre as mesmas variáveis na Vercel (Settings → Environment Variables).
# Nunca faça commit do .env.local.

# --- Supabase (onde os agendamentos ficam gravados) ---
# Sem estas duas, no computador a agenda fica na memória (só para teste); na Vercel ela recusa agendar.
SUPABASE_URL=
# Project Settings → API Keys → secret key (sb_secret_...) ou a antiga service_role. NUNCA a publishable/anon.
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp Cloud API (Meta) ---
# Sem WHATSAPP_TOKEN e WHATSAPP_PHONE_NUMBER_ID = modo teste: as mensagens só aparecem no terminal.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto que você inventa e repete na Meta ao cadastrar o webhook.
WHATSAPP_VERIFY_TOKEN=
# App Dashboard → App settings → Basic → App secret (valida que o webhook veio mesmo da Meta).
WHATSAPP_APP_SECRET=
# Opcionais
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
WA_TEMPLATE_BARBEIRO=novo_agendamento_barbeiro
WA_TEMPLATE_CLIENTE=agendamento_confirmado
WA_TEMPLATE_CANCELADO=agendamento_cancelado
