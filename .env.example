# Copie para .env.local (no computador) e cadastre as mesmas variáveis na Vercel (Settings → Environment Variables).
# Nunca faça commit do .env.local.

# --- Supabase (onde os agendamentos ficam gravados) ---
# Sem estas duas, no computador a agenda fica na memória (só para teste); na Vercel ela recusa agendar.
SUPABASE_URL=
# Project Settings → API Keys → secret key (sb_secret_...) ou a antiga service_role. NUNCA a publishable/anon.
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram (avisos para o barbeiro) ---
# O token que o @BotFather entrega ao criar o bot. Sem ele = modo teste: as mensagens só aparecem no terminal.
TELEGRAM_BOT_TOKEN=
# Um texto aleatório que você inventa (letras, números, _ e -). Vai no setWebhook e protege o /api/telegram.
TELEGRAM_WEBHOOK_SECRET=
